# Optional override of the paired worker address. Leave commented out so the
# viewer uses the address entered in the pairing dialog.
# OPENSHARE_HOST=192.168.1.20
OPENSHARE_PORT=9000

# Streamed video size. Leave unset (commented) to stream at the worker's
# native Retina resolution — much sharper than forcing a fixed size.
# OPENSHARE_VIDEO_WIDTH=1920
# OPENSHARE_VIDEO_HEIGHT=1080
OPENSHARE_TARGET_FPS=30

# How far ahead of the worker's last counter a viewer may jump (resync tolerance)
OPENSHARE_COUNTER_WINDOW=1000
